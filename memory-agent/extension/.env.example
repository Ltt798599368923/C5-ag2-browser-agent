# Memory Agent - Environment Configuration
# Copy this file to .env and fill in your API keys

# ========== LLM Provider (choose one) ==========
PROVIDER=groq
MODEL=llama-3.3-70b-versatile

# Groq (recommended - free tier available)
GROQ_API_KEY=your_groq_key_here

# OpenRouter (supports various models including Gemini)
# OPENROUTER_API_KEY=your_openrouter_key_here

# Google Gemini direct
# GEMINI_API_KEY=your_gemini_key_here

# NVIDIA NIM
# NVIDIA_API_KEY=your_nvidia_key_here

# Cerebras
# CEREBRAS_API_KEY=your_cerebras_key_here

# ========== Web Search (optional) ==========
# Tavily API - enables web search when local knowledge is insufficient
# Get your free key at: https://tavily.com
TAVILY_API_KEY=your_tavily_key_here

# ========== Behavior Settings ==========
# AUTO_SUMMARIZE=true
